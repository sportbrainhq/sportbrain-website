# SportBrainHQ website: example environment.
#
# Copy to .env and fill in. Never commit the real .env.
# Every variable here is read through a validated config layer
# (apps/api/src/config, apps/web/lib/env.ts). No application code
# reads process.env directly.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

API_PORT=4000

# Postgres connection string. Required: the API refuses to start without it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportbrain_web

# Connection pool sizing. Raise POOL_MAX for production traffic.
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug

# Rate limiting: requests per window, per client IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# Swagger UI. Serve it in development only unless you want public API docs.
SWAGGER_ENABLED=true

# Scheduled jobs master switch. Turn off in environments running multiple
# API replicas until a distributed lock exists, or every replica runs
# every cron.
JOBS_ENABLED=false

# Redis connection string. Optional: unset keeps the API on the in-memory
# cache (fine for a single dev replica). Required for shared/durable caching
# and for the News Engine's BullMQ queues once the worker exists.
REDIS_URL=redis://localhost:6379

# Shared-secret guard for /internal/news/* (status, sources). This is a v1
# stopgap, not a real auth/authz system: no per-user identity, no roles, no
# rotation. FAILS CLOSED if unset - every request to those routes is
# rejected, not silently allowed. Generate a real value with e.g.
# `openssl rand -hex 32` before setting this anywhere real.
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# News Engine (RSS ingestion) — apps/api
# ---------------------------------------------------------------------------

# RSS fetch timeout, in milliseconds.
NEWS_RSS_TIMEOUT_MS=10000

# Max bytes accepted for a single feed response.
NEWS_RSS_MAX_RESPONSE_BYTES=5242880

# Retry attempts for a failed feed fetch, before backoff gives up.
NEWS_RSS_RETRY_COUNT=2

# Cross-source story-clustering similarity threshold, 0-1.
NEWS_CLUSTER_SIMILARITY_THRESHOLD=0.82

# Public news API cache TTL, in seconds.
NEWS_CACHE_TTL_SECONDS=120

# Consecutive failed fetches before a source auto-flips to disabled.
NEWS_AUTO_DISABLE_FAILURE_THRESHOLD=10

# Default fetch interval for a source that doesn't override it, in seconds.
NEWS_DEFAULT_FETCH_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# Contact & feedback (apps/api)
# ---------------------------------------------------------------------------

# Public-facing inboxes. Leave unset until the real address exists — an unset
# value means GET /v1/contact/config omits it, rather than the frontend
# advertising an address nobody reads yet.
CONTACT_EMAIL_GENERAL=
CONTACT_EMAIL_CORRECTIONS=
CONTACT_EMAIL_PARTNERSHIPS=
CONTACT_EMAIL_PRESS=

# Where the internal "a submission arrived" notification is sent. Falls back
# to CONTACT_EMAIL_GENERAL when unset.
CONTACT_INTERNAL_NOTIFY_EMAIL=

# Spam protection on POST /v1/contact, tighter than the global default.
CONTACT_RATE_LIMIT_TTL_SECONDS=60
CONTACT_RATE_LIMIT_MAX=3

# ---------------------------------------------------------------------------
# Accounts: Google OAuth + sessions (apps/api)
# ---------------------------------------------------------------------------

# Google Cloud OAuth 2.0 client. Create one in the Google Cloud console
# (APIs & Services -> Credentials -> OAuth client ID -> Web application),
# with GOOGLE_CALLBACK_URL below added as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an authorized redirect URI on the OAuth client above.
# Points at the API, not the web app: the callback is handled server-side.
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# HMAC key that signs the session cookie, so a tampered cookie is rejected
# before it ever reaches the database. No default - generate a real value
# with `openssl rand -hex 32` before setting this anywhere real.
SESSION_SECRET=

# How long a session stays valid without re-authenticating, in seconds.
# Default: 30 days.
SESSION_TTL_SECONDS=2592000

# Shared parent domain for the session cookie, e.g. `.sportbrainhq.com`, so
# the web and API origins can both read it. Leave unset in development - a
# host-only cookie is correct when both origins are localhost.
COOKIE_DOMAIN=

# The web app's public origin. Required: it's the only value the post-login
# redirect is ever allowed to point at, so a missing or wrong value here is
# an open-redirect risk, not just a broken redirect.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------

# Where the web app reaches the API from the server (server components, route
# handlers). Inside Docker this is a service name, not localhost.
API_URL=http://localhost:4000

# Where the *browser* reaches the API from. Must be a publicly reachable
# origin, unlike API_URL above - client-side auth calls (sign-in, logout,
# save/follow) go directly to the API with credentials included.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site origin. Used for canonical URLs, sitemap and Open Graph tags,
# so it must be the real public origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate, which evicts cached pages after an
# ingestion run. Unset means the endpoint refuses every request.
REVALIDATE_SECRET=

# Where ingestion reaches the web app to evict cached pages after a run.
WEB_URL=http://localhost:3000
