# SportBrainHQ website: example environment.
#
# Copy to .env and fill in. Never commit the real .env.
# Every variable here is read through a validated config layer
# (apps/api/src/config, apps/web/lib/env.ts). No application code
# reads process.env directly.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

API_PORT=4000

# Postgres connection string. Required: the API refuses to start without it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportbrain_web

# Connection pool sizing. Raise POOL_MAX for production traffic.
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug

# Rate limiting: requests per window, per client IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# Swagger UI. Serve it in development only unless you want public API docs.
SWAGGER_ENABLED=true

# Scheduled jobs master switch. Turn off in environments running multiple
# API replicas until a distributed lock exists, or every replica runs
# every cron.
JOBS_ENABLED=false

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------

# Where the web app reaches the API from the server (server components, route
# handlers). Inside Docker this is a service name, not localhost.
API_URL=http://localhost:4000

# Public site origin. Used for canonical URLs, sitemap and Open Graph tags,
# so it must be the real public origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
